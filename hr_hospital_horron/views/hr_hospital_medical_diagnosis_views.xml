<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_hospital_medical_diagnosis_view_list" model="ir.ui.view">
        <field name="name">hr.hospital.medical.diagnosis.view.list</field>
        <field name="model">hr.hospital.medical.diagnosis</field>
        <field name="arch" type="xml">
            <list>
                <field name="diagnosis_datetime" string="Date"/>
                <field name="visit_id"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
                <field name="disease_type_id"/>
                <field name="severity"/>
                <field name="approved"/>
                <field name="approved_by_doctor_id"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_medical_diagnosis_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.medical.diagnosis.view.form</field>
        <field name="model">hr.hospital.medical.diagnosis</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="approved"/>
                </header>
                <sheet>
                    <group>
                        <field name="visit_id"/>
                        <field name="disease_id"/>
                        <field name="severity"/>
                    </group>
                    <group>
                        <field name="approved" readonly="1"/>
                        <field name="approved_by_doctor_id" readonly="1"/>
                        <field name="approved_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="treatment_html" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_medical_diagnosis_view_pivot" model="ir.ui.view">
        <field name="name">hr.hospital.medical.diagnosis.view.pivot</field>
        <field name="model">hr.hospital.medical.diagnosis</field>
        <field name="arch" type="xml">
            <pivot string="Disease Cases by Type and Month">
                <field name="disease_type_id" type="row"/>
                <field name="disease_id" type="row"/>
                <field name="diagnosis_date" type="col" interval="year"/>
                <field name="diagnosis_datetime" type="col" interval="month"/>
            </pivot>
        </field>
    </record>

    <record id="hr_hospital_medical_diagnosis_view_graph" model="ir.ui.view">
        <field name="name">hr.hospital.medical.diagnosis.view.graph</field>
        <field name="model">hr.hospital.medical.diagnosis</field>
        <field name="arch" type="xml">
            <graph string="Disease Incidence by Month" type="bar">
                <field name="diagnosis_datetime" interval="month"/>
                <field name="disease_type_id"/>
            </graph>
        </field>
    </record>

    <record id="hr_hospital_medical_diagnosis_view_search" model="ir.ui.view">
        <field name="name">hr.hospital.medical.diagnosis.view.search</field>
        <field name="model">hr.hospital.medical.diagnosis</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
                <filter name="approved" string="Approved" domain="[('approved', '=', True)]"/>
                <filter name="pending" string="Pending Approval" domain="[('approved', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_by_disease" string="Disease" context="{'group_by': 'disease_id'}"/>
                    <filter name="group_by_type" string="Disease Type" context="{'group_by': 'disease_type_id'}"/>
                    <filter name="group_by_month" string="Month" context="{'group_by': 'diagnosis_datetime:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_hospital_medical_diagnosis_action" model="ir.actions.act_window">
        <field name="name">Diagnoses</field>
        <field name="res_model">hr.hospital.medical.diagnosis</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="hr_hospital_medical_diagnosis_view_search"/>
    </record>
</odoo>
