<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_hospital_visit_view_list" model="ir.ui.view">
        <field name="name">hr.hospital.visit.view.list</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="planned_datetime"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="state"/>
                <field name="visit_type"/>
                <field name="diagnosis_count"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_visit_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.view.form</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done,cancelled,no_show"/>
                    <button name="%(hr_hospital_reschedule_visit_wizard_action)d" type="action" string="Reschedule"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="planned_datetime"/>
                            <field name="actual_datetime" readonly="state != 'done'"/>
                            <field name="visit_type"/>
                        </group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="fee"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="disease_id"/>
                    </group>
                    <notebook>
                        <page string="Diagnoses">
                            <field name="diagnosis_ids" context="{'default_visit_id': id}"/>
                        </page>
                        <page string="Recommendations">
                            <field name="recommendations" nolabel="1"/>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_visit_view_calendar" model="ir.ui.view">
        <field name="name">hr.hospital.visit.view.calendar</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <calendar date_start="planned_datetime" color="doctor_id">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="state"/>
                <field name="visit_type"/>
            </calendar>
        </field>
    </record>

    <record id="hr_hospital_visit_view_pivot" model="ir.ui.view">
        <field name="name">hr.hospital.visit.view.pivot</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visits by Doctor and Status">
                <field name="doctor_id" type="row"/>
                <field name="state" type="col"/>

            </pivot>
        </field>
    </record>

    <record id="hr_hospital_visit_view_search" model="ir.ui.view">
        <field name="name">hr.hospital.visit.view.search</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <filter
                    name="current_month"
                    string="Current Month"
                    domain="[('planned_datetime', 'ilike', context_today().strftime('%Y-%m'))]"
                />
                <separator/>
                <filter name="planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter name="no_show" string="No Show" domain="[('state', '=', 'no_show')]"/>
                <group name="group_by">
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_doctor" string="Doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_by_patient" string="Patient" context="{'group_by': 'patient_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_hospital_visit_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">list,calendar,form,pivot</field>
        <field name="search_view_id" ref="hr_hospital_visit_view_search"/>
    </record>

    <record id="hr_hospital_visit_monthly_pivot_action" model="ir.actions.act_window">
        <field name="name">Visits by Doctor/Status (Month)</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="view_id" ref="hr_hospital_visit_view_pivot"/>
        <field name="search_view_id" ref="hr_hospital_visit_view_search"/>
        <field name="context">{'search_default_current_month': 1, 'search_default_group_by_doctor': 1, 'search_default_group_by_state': 1}</field>
    </record>
</odoo>
