<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_hospital_visit_view_list" model="ir.ui.view">
        <field name="name">hr.hospital.visit.view.list</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="planned_datetime"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="state"/>
                <field name="visit_type"/>
                <field name="diagnosis_count"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_visit_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.view.form</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done,cancelled,no_show"/>
                    <button name="%(hr_hospital_reschedule_visit_wizard_action)d" type="action" string="Reschedule"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="planned_datetime"/>
                            <field name="actual_datetime" readonly="state != 'done'"/>
                            <field name="visit_type"/>
                        </group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="fee"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="disease_id"/>
                    </group>
                    <notebook>
                        <page string="Diagnoses">
                            <field name="diagnosis_ids" context="{'default_visit_id': id}"/>
                        </page>
                        <page string="Recommendations">
                            <field name="recommendations" nolabel="1"/>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_visit_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
