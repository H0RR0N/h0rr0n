<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
      Demo doctors: a small, believable clinic staff dataset.
      The goal is readability in the UI + convenient data for demonstrating domains/constraints/wizards.

      Notes:
      - Emails use a fake domain.
      - License numbers are consistent and unique.
      - Two doctors are interns and have mentors.
      - Each doctor is linked to a dedicated demo user account (user_id).
    -->

    <!-- Senior doctors -->
    <record id="hr_hospital_doctor_ivanov" model="hr.hospital.doctor">
        <field name="name">Ivan Ivanov</field>
        <field name="last_name">Ivanov</field>
        <field name="first_name">Ivan</field>
        <field name="phone">+380501234567</field>
        <field name="email">ivan.ivanov@demo-hospital.example</field>
        <field name="speciality_id" ref="hr_hospital_speciality_therapy"/>
        <field name="specialization">Therapist</field>
        <field name="license_number">UA-LIC-2012-0001</field>
        <field name="license_date">2012-05-20</field>
        <field name="rating">4.7</field>
        <field name="user_id" ref="hr_hospital_user_doctor_ivanov"/>
        <field name="education_country_id" ref="base.ua"/>
    </record>

