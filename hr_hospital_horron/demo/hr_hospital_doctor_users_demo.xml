<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
      Demo users for doctors.

      Purpose:
      - Make it possible to log in as a doctor.
      - Provide a stable link between hr.hospital.doctor.user_id and res.users.

      Notes:
      - Password is set to "demo" for all demo users.
      - Groups: internal user (base.group_user).
      - Logins are unique and easy to recognize.
    -->

    <record id="hr_hospital_user_doctor_ivanov" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Ivan Ivanov</field>
        <field name="login">dr.ivanov</field>
        <field name="email">ivan.ivanov@demo-hospital.example</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="password">demo</field>
    </record>

