<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
      Demo diseases:
      - A small but readable hierarchy (2–3 levels).
      - Some diseases are marked as contagious + high/critical danger level.
        Those are used by the diagnosis domain.
      - ICD-10 codes are provided for realism.
    -->

    <!-- Infectious diseases (contagious) -->
    <record id="hr_hospital_demo_disease_infection" model="hr.hospital.disease">
        <field name="name">Infectious diseases</field>
        <field name="code">INF</field>
        <field name="icd10_code">A00</field>
        <field name="danger_level">high</field>
        <field name="is_contagious">1</field>
        <field name="description">Top-level category for common infectious diseases.</field>
        <field name="region_country_ids" eval="[(6, 0, [ref('base.ua'), ref('base.us')])]"/>
    </record>

    <record id="hr_hospital_demo_disease_flu" model="hr.hospital.disease">
        <field name="name">Influenza</field>
        <field name="code">FLU</field>
        <field name="icd10_code">J10</field>
        <field name="danger_level">medium</field>
        <field name="is_contagious">1</field>
        <field name="parent_id" ref="hr_hospital_demo_disease_infection"/>
        <field name="symptoms">Fever, cough, sore throat, fatigue</field>
        <field name="region_country_ids" eval="[(6, 0, [ref('base.ua')])]"/>
    </record>

    <record id="hr_hospital_demo_disease_covid" model="hr.hospital.disease">
        <field name="name">COVID-19</field>
        <field name="code">COVID</field>
        <field name="icd10_code">U07</field>
        <field name="danger_level">critical</field>
        <field name="is_contagious">1</field>
        <field name="parent_id" ref="hr_hospital_demo_disease_infection"/>
        <field name="symptoms">Fever, cough, shortness of breath, weakness</field>
        <field name="region_country_ids" eval="[(6, 0, [ref('base.ua'), ref('base.us')])]"/>
    </record>

    <!-- Cardiovascular -->
    <record id="hr_hospital_demo_disease_cardiovascular" model="hr.hospital.disease">
        <field name="name">Cardiovascular diseases</field>
        <field name="code">CARD</field>
        <field name="icd10_code">I00</field>
        <field name="danger_level">high</field>
        <field name="description">Heart and blood vessel disorders.</field>
        <field name="region_country_ids" eval="[(6, 0, [ref('base.ua'), ref('base.de')])]"/>
    </record>

    <record id="hr_hospital_demo_disease_hypertension" model="hr.hospital.disease">
        <field name="name">Hypertension</field>
        <field name="code">HYP</field>
        <field name="icd10_code">I10</field>
        <field name="danger_level">medium</field>
        <field name="parent_id" ref="hr_hospital_demo_disease_cardiovascular"/>
        <field name="symptoms">High blood pressure, headaches</field>
    </record>

    <record id="hr_hospital_demo_disease_arrhythmia" model="hr.hospital.disease">
        <field name="name">Arrhythmia</field>
        <field name="code">ARR</field>
        <field name="icd10_code">I49</field>
        <field name="danger_level">high</field>
        <field name="parent_id" ref="hr_hospital_demo_disease_cardiovascular"/>
        <field name="symptoms">Irregular heartbeat, dizziness</field>
    </record>

    <!-- Endocrine -->
    <record id="hr_hospital_demo_disease_endocrine" model="hr.hospital.disease">
        <field name="name">Endocrine disorders</field>
        <field name="code">ENDO</field>
        <field name="icd10_code">E00</field>
        <field name="danger_level">medium</field>
        <field name="description">Endocrine system disorders.</field>
        <field name="region_country_ids" eval="[(6, 0, [ref('base.pl')])]"/>
    </record>

    <record id="hr_hospital_demo_disease_diabetes" model="hr.hospital.disease">
        <field name="name">Type 2 diabetes</field>
        <field name="code">DIA</field>
        <field name="icd10_code">E11</field>
        <field name="danger_level">high</field>
        <field name="parent_id" ref="hr_hospital_demo_disease_endocrine"/>
        <field name="symptoms">High blood sugar, thirst, fatigue</field>
    </record>

    <record id="hr_hospital_demo_disease_thyroid" model="hr.hospital.disease">
        <field name="name">Thyroiditis</field>
        <field name="code">THY</field>
        <field name="icd10_code">E06</field>
        <field name="danger_level">medium</field>
        <field name="parent_id" ref="hr_hospital_demo_disease_endocrine"/>
        <field name="symptoms">Neck discomfort, fatigue</field>
    </record>

    <!-- Neurology -->
    <record id="hr_hospital_demo_disease_neuro" model="hr.hospital.disease">
        <field name="name">Neurological disorders</field>
        <field name="code">NEUR</field>
        <field name="icd10_code">G00</field>
        <field name="danger_level">medium</field>
        <field name="description">Central nervous system disorders.</field>
        <field name="region_country_ids" eval="[(6, 0, [ref('base.us')])]"/>
    </record>

    <record id="hr_hospital_demo_disease_migraine" model="hr.hospital.disease">
        <field name="name">Migraine</field>
        <field name="code">MIG</field>
        <field name="icd10_code">G43</field>
        <field name="danger_level">low</field>
        <field name="parent_id" ref="hr_hospital_demo_disease_neuro"/>
        <field name="symptoms">Headache, nausea, sensitivity to light</field>
    </record>

    <record id="hr_hospital_demo_disease_epilepsy" model="hr.hospital.disease">
        <field name="name">Epilepsy</field>
        <field name="code">EPI</field>
        <field name="icd10_code">G40</field>
        <field name="danger_level">high</field>
        <field name="parent_id" ref="hr_hospital_demo_disease_neuro"/>
        <field name="symptoms">Seizures</field>
    </record>
</odoo>
