<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_hospital_reschedule_visit_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.reschedule.visit.wizard.view.form</field>
        <field name="model">hr.hospital.reschedule.visit.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="current_visit_id"/>
                        <field name="new_doctor_id"/>
                    </group>
                    <group>
                        <field name="new_date"/>
                        <field name="new_time" widget="float_time" placeholder="09:00"/>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_reschedule" type="object" string="Reschedule" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_hospital_reschedule_visit_wizard_action" model="ir.actions.act_window">
        <field name="name">Reschedule Visit</field>
        <field name="res_model">hr.hospital.reschedule.visit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_current_visit_id': active_id}</field>
    </record>
</odoo>
