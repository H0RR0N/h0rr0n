<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_hospital_doctor_schedule_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.schedule.wizard.view.form</field>
        <field name="model">hr.hospital.doctor.schedule.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="doctor_id"/>
                        <field name="week_start"/>
                        <field name="weeks"/>
                        <field name="schedule_mode"/>
                    </group>
                    <group>
                        <field name="day_mon"/>
                        <field name="day_tue"/>
                        <field name="day_wed"/>
                        <field name="day_thu"/>
                        <field name="day_fri"/>
                        <field name="day_sat"/>
                        <field name="day_sun"/>
                    </group>
                    <group>
                        <field name="time_start" widget="float_time" placeholder="09:00"/>
                        <field name="time_end" widget="float_time" placeholder="17:00"/>
                        <field name="break_from" widget="float_time" placeholder="13:00"/>
                        <field name="break_to" widget="float_time" placeholder="14:00"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" type="object" string="Create Schedule" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_hospital_doctor_schedule_wizard_action" model="ir.actions.act_window">
        <field name="name">Generate Schedule</field>
        <field name="res_model">hr.hospital.doctor.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
