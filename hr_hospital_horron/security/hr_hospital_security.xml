            [(0, '=', 1)] if user.has_group('hr_hospital_horron.group_hr_hospital_manager') else ['|', ('patient_id.visit_ids.doctor_id.user_id', '=', user.id), ('patient_id.visit_ids.doctor_id.mentor_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_hr_hospital_doctor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_hospital_history_rule_manager" model="ir.rule">
