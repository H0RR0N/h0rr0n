#. module: hr_unique_email_partner
#: model:ir.module.module,summary:base.module_hr_unique_email_partner
msgid "Prevents duplicate email addresses across partners (res.partner)."
msgstr "Запобігає дублюванню адрес електронної пошти серед партнерів (res.partner)."

#. module: hr_unique_email_partner
#. odoo-python
#: code:addons/hr_unique_email_partner/models/res_partner.py:0
msgid ""
"The email address '%(email)s' is already used by "
"partner '%(partner)s'. Each partner must have a "
"unique email address."
msgstr ""
"Адресу електронної пошти '%(email)s' вже використовує "
"партнер '%(partner)s'. Кожен партнер повинен мати "
"унікальну адресу електронної пошти."
