<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_courier_route_generate_wizard_form" model="ir.ui.view">
        <field name="name">courier.route.generate.wizard.form</field>
        <field name="model">courier.route.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Route">
                <group>
                    <group>
                        <field name="route_id"/>
                        <field name="zone_id"/>
                        <field name="courier_id"/>
                    </group>
                    <group>
                        <field name="date_planned"/>
                        <field name="track_id" domain="[('zone_id', '=', zone_id)]"/>
                    </group>
                </group>
                <group>
                    <field name="picking_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_generate_route" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_courier_route_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Route</field>
        <field name="res_model">courier.route.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_courier_route_generate_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
