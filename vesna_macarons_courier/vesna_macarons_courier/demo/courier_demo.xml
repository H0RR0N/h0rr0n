<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="demo_partner_north" model="res.partner">
            <field name="name">North Customer</field>
            <field name="courier_latitude">46.5330</field>
            <field name="courier_longitude">30.7420</field>
        </record>

        <record id="demo_partner_center" model="res.partner">
            <field name="name">Center Customer</field>
            <field name="courier_latitude">46.4840</field>
            <field name="courier_longitude">30.7390</field>
        </record>

        <record id="demo_partner_south" model="res.partner">
            <field name="name">South Customer</field>
            <field name="courier_latitude">46.4440</field>
            <field name="courier_longitude">30.7290</field>
        </record>

        <record id="demo_zone_north" model="courier.zone">
            <field name="name">North Zone</field>
            <field name="code">north</field>
            <field name="version">1</field>
            <field name="color">#2da44e</field>
            <field name="polygon_geojson">{"type":"Polygon","coordinates":[[[30.68,46.50],[30.79,46.50],[30.79,46.56],[30.68,46.56],[30.68,46.50]]]}</field>
            <field name="courier_user_ids" eval="[(6,0,[ref('base.user_admin')])]"/>
        </record>

        <record id="demo_zone_center" model="courier.zone">
            <field name="name">Center Zone</field>
            <field name="code">center</field>
            <field name="version">1</field>
            <field name="color">#fb8500</field>
            <field name="polygon_geojson">{"type":"Polygon","coordinates":[[[30.68,46.46],[30.79,46.46],[30.79,46.50],[30.68,46.50],[30.68,46.46]]]}</field>
            <field name="courier_user_ids" eval="[(6,0,[ref('base.user_admin')])]"/>
        </record>

        <record id="demo_zone_south" model="courier.zone">
            <field name="name">South Zone</field>
            <field name="code">south</field>
            <field name="version">1</field>
            <field name="color">#1f6feb</field>
            <field name="polygon_geojson">{"type":"Polygon","coordinates":[[[30.68,46.41],[30.79,46.41],[30.79,46.46],[30.68,46.46],[30.68,46.41]]]}</field>
            <field name="courier_user_ids" eval="[(6,0,[ref('base.user_admin')])]"/>
        </record>

        <record id="demo_track_north" model="courier.gpx.track">
            <field name="name">North Main</field>
            <field name="code">north_main_demo</field>
            <field name="zone_id" ref="demo_zone_north"/>
            <field name="source">module</field>
            <field name="gpx_file" type="base64" file="vesna_macarons_courier/data/routes/north_main.gpx"/>
            <field name="gpx_filename">north_main.gpx</field>
            <field name="line_geojson">{"type":"LineString","coordinates":[[30.7100,46.5200],[30.7300,46.5250],[30.7450,46.5350],[30.7600,46.5400]]}</field>
            <field name="point_count">4</field>
        </record>

        <record id="demo_track_center" model="courier.gpx.track">
            <field name="name">Center Main</field>
            <field name="code">center_main_demo</field>
            <field name="zone_id" ref="demo_zone_center"/>
            <field name="source">module</field>
            <field name="gpx_file" type="base64" file="vesna_macarons_courier/data/routes/center_main.gpx"/>
            <field name="gpx_filename">center_main.gpx</field>
            <field name="line_geojson">{"type":"LineString","coordinates":[[30.7100,46.4700],[30.7250,46.4800],[30.7400,46.4850],[30.7550,46.4900]]}</field>
            <field name="point_count">4</field>
        </record>

        <record id="demo_track_south" model="courier.gpx.track">
            <field name="name">South Main</field>
            <field name="code">south_main_demo</field>
            <field name="zone_id" ref="demo_zone_south"/>
            <field name="source">module</field>
            <field name="gpx_file" type="base64" file="vesna_macarons_courier/data/routes/south_main.gpx"/>
            <field name="gpx_filename">south_main.gpx</field>
            <field name="line_geojson">{"type":"LineString","coordinates":[[30.7000,46.4300],[30.7150,46.4400],[30.7300,46.4450],[30.7450,46.4500]]}</field>
            <field name="point_count">4</field>
        </record>

        <record id="demo_batch_north" model="courier.dispatch.batch">
            <field name="name">BAT/DEMO/0001</field>
            <field name="zone_id" ref="demo_zone_north"/>
            <field name="state">draft</field>
        </record>

        <record id="demo_batch_center" model="courier.dispatch.batch">
            <field name="name">BAT/DEMO/0002</field>
            <field name="zone_id" ref="demo_zone_center"/>
            <field name="state">assigned</field>
        </record>

        <record id="demo_batch_south" model="courier.dispatch.batch">
            <field name="name">BAT/DEMO/0003</field>
            <field name="zone_id" ref="demo_zone_south"/>
            <field name="state">done</field>
        </record>

        <record id="demo_route_north" model="courier.route">
            <field name="name">RTE/DEMO/0001</field>
            <field name="zone_id" ref="demo_zone_north"/>
            <field name="courier_id" ref="base.user_admin"/>
            <field name="batch_id" ref="demo_batch_north"/>
            <field name="track_id" ref="demo_track_north"/>
            <field name="state">draft</field>
        </record>

        <record id="demo_route_center" model="courier.route">
            <field name="name">RTE/DEMO/0002</field>
            <field name="zone_id" ref="demo_zone_center"/>
            <field name="courier_id" ref="base.user_admin"/>
            <field name="batch_id" ref="demo_batch_center"/>
            <field name="track_id" ref="demo_track_center"/>
            <field name="state">in_progress</field>
        </record>

        <record id="demo_route_south" model="courier.route">
            <field name="name">RTE/DEMO/0003</field>
            <field name="zone_id" ref="demo_zone_south"/>
            <field name="courier_id" ref="base.user_admin"/>
            <field name="batch_id" ref="demo_batch_south"/>
            <field name="track_id" ref="demo_track_south"/>
            <field name="state">done</field>
        </record>

        <record id="demo_route_stop_north" model="courier.route.stop">
            <field name="route_id" ref="demo_route_north"/>
            <field name="sequence">10</field>
            <field name="partner_id" ref="demo_partner_north"/>
            <field name="latitude">46.5330</field>
            <field name="longitude">30.7420</field>
            <field name="status">pending</field>
        </record>

        <record id="demo_route_stop_center" model="courier.route.stop">
            <field name="route_id" ref="demo_route_center"/>
            <field name="sequence">10</field>
            <field name="partner_id" ref="demo_partner_center"/>
            <field name="latitude">46.4840</field>
            <field name="longitude">30.7390</field>
            <field name="status">delivered</field>
        </record>

        <record id="demo_route_stop_south" model="courier.route.stop">
            <field name="route_id" ref="demo_route_south"/>
            <field name="sequence">10</field>
            <field name="partner_id" ref="demo_partner_south"/>
            <field name="latitude">46.4440</field>
            <field name="longitude">30.7290</field>
            <field name="status">failed</field>
        </record>

        <record id="demo_shift_north" model="courier.driver.shift">
            <field name="user_id" ref="base.user_admin"/>
            <field name="zone_id" ref="demo_zone_north"/>
            <field name="start_at">2026-03-01 08:00:00</field>
            <field name="end_at">2026-03-01 17:00:00</field>
            <field name="state">closed</field>
        </record>

        <record id="demo_shift_center" model="courier.driver.shift">
            <field name="user_id" ref="base.user_admin"/>
            <field name="zone_id" ref="demo_zone_center"/>
            <field name="start_at">2026-03-02 08:00:00</field>
            <field name="end_at">2026-03-02 17:00:00</field>
            <field name="state">closed</field>
        </record>

        <record id="demo_shift_south" model="courier.driver.shift">
            <field name="user_id" ref="base.user_admin"/>
            <field name="zone_id" ref="demo_zone_south"/>
            <field name="start_at">2026-03-03 08:00:00</field>
            <field name="end_at">2026-03-03 17:00:00</field>
            <field name="state">closed</field>
        </record>
    </data>
</odoo>
