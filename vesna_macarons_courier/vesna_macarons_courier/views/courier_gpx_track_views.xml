<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_courier_gpx_track_tree" model="ir.ui.view">
        <field name="name">courier.gpx.track.tree</field>
        <field name="model">courier.gpx.track</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="zone_id"/>
                <field name="source"/>
                <field name="point_count"/>
                <field name="version"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <record id="view_courier_gpx_track_form" model="ir.ui.view">
        <field name="name">courier.gpx.track.form</field>
        <field name="model">courier.gpx.track</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_parse_gpx" type="object" string="Parse GPX" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="zone_id"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="version"/>
                            <field name="is_active"/>
                            <field name="point_count" readonly="1"/>
                            <field name="parsed_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="gpx_file" filename="gpx_filename"/>
                        <field name="gpx_filename"/>
                        <field name="checksum" readonly="1"/>
                    </group>
                    <group>
                        <field name="line_geojson" readonly="1"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_courier_gpx_track_search" model="ir.ui.view">
        <field name="name">courier.gpx.track.search</field>
        <field name="model">courier.gpx.track</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="zone_id"/>
                <filter string="Module" name="source_module" domain="[('source', '=', 'module')]"/>
                <filter string="Manual" name="source_manual" domain="[('source', '=', 'manual')]"/>
            </search>
        </field>
    </record>

    <record id="action_courier_gpx_track" model="ir.actions.act_window">
        <field name="name">GPX Tracks</field>
        <field name="res_model">courier.gpx.track</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_courier_gpx_track_search"/>
    </record>
</odoo>
