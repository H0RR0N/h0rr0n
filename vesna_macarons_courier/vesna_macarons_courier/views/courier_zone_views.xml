<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_courier_zone_tree" model="ir.ui.view">
        <field name="name">courier.zone.tree</field>
        <field name="model">courier.zone</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="version"/>
                <field name="courier_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_courier_zone_form" model="ir.ui.view">
        <field name="name">courier.zone.form</field>
        <field name="model">courier.zone</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate_geojson" type="object" string="Validate GeoJSON" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="active_from"/>
                            <field name="active_to"/>
                            <field name="color" widget="color"/>
                            <field name="courier_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="courier_user_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="polygon_geojson" nolabel="1" placeholder='{"type":"Polygon","coordinates":[[[30.0,46.0],[30.1,46.0],[30.1,46.1],[30.0,46.0]]]}'/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_courier_zone_search" model="ir.ui.view">
        <field name="name">courier.zone.search</field>
        <field name="model">courier.zone</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_courier_zone" model="ir.actions.act_window">
        <field name="name">Courier Zones</field>
        <field name="res_model">courier.zone</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_courier_zone_search"/>
    </record>
</odoo>
