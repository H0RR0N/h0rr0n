<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_courier_dispatch_batch_tree" model="ir.ui.view">
        <field name="name">courier.dispatch.batch.tree</field>
        <field name="model">courier.dispatch.batch</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="zone_id"/>
                <field name="date_planned"/>
                <field name="picking_count"/>
                <field name="route_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_courier_dispatch_batch_form" model="ir.ui.view">
        <field name="name">courier.dispatch.batch.form</field>
        <field name="model">courier.dispatch.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_assign_zone_to_pickings" type="object" string="Recompute Zones" class="btn-secondary"/>
                    <button name="action_mark_assigned" type="object" string="Mark Assigned" class="btn-primary" states="draft"/>
                    <button name="action_mark_done" type="object" string="Mark Done" class="btn-primary" states="assigned"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_routes" type="object" class="oe_stat_button" icon="fa-road">
                            <field name="route_count" widget="statinfo" string="Routes"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="zone_id"/>
                        </group>
                        <group>
                            <field name="date_planned"/>
                            <field name="picking_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pickings">
                            <field name="picking_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Routes">
                            <field name="route_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="courier_id"/>
                                    <field name="date_planned"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_courier_dispatch_batch_search" model="ir.ui.view">
        <field name="name">courier.dispatch.batch.search</field>
        <field name="model">courier.dispatch.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="zone_id"/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Assigned" name="state_assigned" domain="[('state', '=', 'assigned')]"/>
            </search>
        </field>
    </record>

    <record id="action_courier_dispatch_batch" model="ir.actions.act_window">
        <field name="name">Dispatch Batches</field>
        <field name="res_model">courier.dispatch.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_courier_dispatch_batch_search"/>
    </record>
</odoo>
