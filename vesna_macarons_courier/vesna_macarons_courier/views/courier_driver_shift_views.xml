<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_courier_driver_shift_tree" model="ir.ui.view">
        <field name="name">courier.driver.shift.tree</field>
        <field name="model">courier.driver.shift</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="user_id"/>
                <field name="zone_id"/>
                <field name="start_at"/>
                <field name="end_at"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_courier_driver_shift_form" model="ir.ui.view">
        <field name="name">courier.driver.shift.form</field>
        <field name="model">courier.driver.shift</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_shift" type="object" string="Open" class="btn-primary" states="draft"/>
                    <button name="action_close_shift" type="object" string="Close" class="btn-secondary" states="open"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="user_id"/>
                            <field name="zone_id"/>
                        </group>
                        <group>
                            <field name="start_at"/>
                            <field name="end_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_courier_driver_shift" model="ir.actions.act_window">
        <field name="name">Driver Shifts</field>
        <field name="res_model">courier.driver.shift</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
