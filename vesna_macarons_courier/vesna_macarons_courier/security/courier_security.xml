<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_courier" model="ir.module.category">
            <field name="name">Courier</field>
            <field name="description">Courier routing and delivery tracking</field>
            <field name="sequence">35</field>
        </record>

        <record id="group_courier_user" model="res.groups">
            <field name="name">Courier User</field>
            <field name="category_id" ref="vesna_macarons_courier.module_category_courier"/>
        </record>

        <record id="group_courier_admin" model="res.groups">
            <field name="name">Courier Admin</field>
            <field name="category_id" ref="vesna_macarons_courier.module_category_courier"/>
            <field name="implied_ids" eval="[(4, ref('vesna_macarons_courier.group_courier_user'))]"/>
        </record>
    </data>
</odoo>
