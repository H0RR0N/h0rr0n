<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_courier_route" model="ir.sequence">
            <field name="name">Courier Route</field>
            <field name="code">courier.route</field>
            <field name="prefix">RTE/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_courier_dispatch_batch" model="ir.sequence">
            <field name="name">Courier Dispatch Batch</field>
            <field name="code">courier.dispatch.batch</field>
            <field name="prefix">BAT/%(year)s/</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
