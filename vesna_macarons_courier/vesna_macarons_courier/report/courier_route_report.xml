<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_courier_route" model="ir.actions.report">
        <field name="name">Route Sheet</field>
        <field name="model">courier.route</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vesna_macarons_courier.report_courier_route_document</field>
        <field name="report_file">vesna_macarons_courier.report_courier_route_document</field>
        <field name="print_report_name">'Route Sheet - %s' % (object.name)</field>
    </record>

    <template id="report_courier_route_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="route">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Route Sheet: <span t-esc="route.name"/></h2>
                        <p>
                            <strong>Date:</strong> <span t-esc="route.date_planned"/>
                            <br/>
                            <strong>Zone:</strong> <span t-esc="route.zone_id.display_name"/>
                            <br/>
                            <strong>Courier:</strong> <span t-esc="route.courier_id.display_name"/>
                        </p>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Customer</th>
                                    <th>Transfer</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="route.stop_ids" t-as="stop">
                                    <td><span t-esc="stop.sequence"/></td>
                                    <td><span t-esc="stop.partner_id.display_name"/></td>
                                    <td><span t-esc="stop.picking_id.name or '-'"/></td>
                                    <td><span t-esc="stop.status"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
